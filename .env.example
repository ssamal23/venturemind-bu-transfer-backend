# Copy to .env (never commit .env)
# Local Docker Postgres:
DATABASE_URL=postgresql+psycopg://bu:bu@localhost:5432/transfer
# Azure Database for PostgreSQL (SSL is required):
# DATABASE_URL=postgresql+psycopg://APPUSER:PASSWORD@SERVERNAME.postgres.database.azure.com:5432/transfer?sslmode=require

EMBEDDING_DIM=384
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

JWT_SECRET=
CORS_ORIGINS=["http://localhost:5173"]
STORAGE_DIR=storage

# LLM gateway (leave a key empty to skip that provider)
LLM_CHAIN=["claude","gemini"]
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-2.5-flash
FORCE_PRIMARY_FAIL=false
WORKER_MAX_ATTEMPTS=4

# Azure (leave these out for local development)
# STORAGE_BACKEND=azure
# AZURE_STORAGE_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net
# CHECKPOINT_AUTO_SETUP=false
# DATA_DIR=
